{
  "name": "mails-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 3160",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create mails",
    "db:schema": "wrangler d1 execute mails --file=schema.sql",
    "db:schema:local": "wrangler d1 execute mails --local --file=schema.sql",
    "mails:cli-login": "node ./scripts/mails-cli-login.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "wrangler": "^4"
  },
  "dependencies": {
    "postal-mime": "^2.7.4"
  }
}
